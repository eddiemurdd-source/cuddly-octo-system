[
 {"id": "L01", "kim": "anlatici", "text": "Saat sabahın beşi. Bütün şehir uyuyor."},
 {"id": "L02", "kim": "anlatici", "text": "Canın istemiyor."},
 {"id": "L03", "kim": "anlatici", "text": "Yine de kalkıyorsun."},
 {"id": "L04", "kim": "anlatici", "text": "Kimse izlemiyorken."},
 {"id": "L05", "kim": "anlatici", "text": "Yağmurda."},
 {"id": "L06", "kim": "anlatici", "text": "Yorgunken."},
 {"id": "L07", "kim": "anlatici", "text": "Her gün, sadece yüzde bir daha iyi."},
 {"id": "L08", "kim": "anlatici", "text": "Bir yıl sonra?"},
 {"id": "L09", "kim": "anlatici", "text": "Otuz yedi kat."},
 {"id": "L10", "kim": "anlatici", "text": "Motivasyon gelir, gider."},
 {"id": "L11", "kim": "anlatici", "text": "Ama disiplin kalır."},
 {"id": "L12", "kim": "anlatici", "text": "Yarın değil. Bugün başla."}
]
